# Configuración para setup-timemachine-truenas.sh
# Copia este archivo a .env y configura tus valores reales

# API Key de TrueNAS (obtener desde la interfaz web de TrueNAS)
TRUENAS_API_KEY=tu_api_key_aqui

# Host de TrueNAS
TRUENAS_HOST=192.168.1.20

# Nombre del dataset para Time Machine
DATASET_NAME=timemachine

# Nombre del pool de almacenamiento
POOL_NAME=homelab-storage

# Contraseña para el usuario timemachine (opcional, se genera automáticamente si no se especifica)
# TIMEMACHINE_PASSWORD=contraseña_personalizada
