FROM postgres:15-alpine

# Instalar dependencias necesarias
RUN apk add --no-cache \
    git \
    build-base \
    clang \
    llvm \
    postgresql15-dev

# Clonar y compilar pgvector
RUN git clone --branch v0.7.0 https://github.com/pgvector/pgvector.git \
    && cd pgvector \
    && make \
    && make install

# Limpiar
RUN apk del git build-base clang llvm postgresql15-dev \
    && rm -rf pgvector
