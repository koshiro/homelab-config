  {
   "id": 14,
   "type": "timeseries",
   "title": "Red del host Proxmox (vmbr0)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "rate(node_network_receive_bytes_total{instance=\"pve\",device=\"vmbr0\"}[$__rate_interval]) * 8",
     "legendFormat": "entrada",
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "rate(node_network_transmit_bytes_total{instance=\"pve\",device=\"vmbr0\"}[$__rate_interval]) * 8",
     "legendFormat": "salida",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Speedtest",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "speedtest_download_bits_per_second",
     "legendFormat": "bajada",
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "speedtest_upload_bits_per_second",
     "legendFormat": "subida",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
