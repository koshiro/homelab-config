{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Actualizaciones de imágenes del cluster por PR. Sin Flux no hay automerge: tras mergear, aplicar con kubectl apply -k (main = estado del cluster). Al instalar Flux, activar automerge en los grupos de bajo riesgo.",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", ":timezone(America/Santiago)"],
  "schedule": ["* 6-12 * * 6"],
  "labels": ["renovate"],
  "prConcurrentLimit": 6,
  "prHourlyLimit": 3,
  "commitMessageAction": "actualizar",
  "commitMessageExtra": "a {{{newValue}}}",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "kubernetes": {
    "managerFilePatterns": ["/^cluster/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Manifiestos remotos fijados por versión en kustomization (cert-manager, plugin Barman Cloud)",
      "managerFilePatterns": ["/^cluster/.+/kustomization\\.ya?ml$/"],
      "matchStrings": ["https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[^/]+)/"],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "imageName de los Cluster de CloudNativePG",
      "managerFilePatterns": ["/^cluster/.+\\.ya?ml$/"],
      "matchStrings": ["imageName:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Mayores: PR propio y etiqueta, leer notas de versión antes de mergear",
      "matchUpdateTypes": ["major"],
      "addLabels": ["mayor"]
    },
    {
      "description": "Bajo riesgo: un PR semanal para monitoreo",
      "matchPackageNames": [
        "victoriametrics/**",
        "grafana/grafana",
        "prom/**",
        "registry.k8s.io/kube-state-metrics/**",
        "prompve/prometheus-pve-exporter",
        "miguelndecarvalho/speedtest-exporter"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "monitoreo"
    },
    {
      "description": "Bajo riesgo: imágenes utilitarias de jobs y sidecars",
      "matchPackageNames": ["alpine", "busybox", "curlimages/curl", "python", "registry.k8s.io/kubectl"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "utilidades"
    },
    {
      "description": "Red: cloudflared (los dos túneles a la vez) y DDNS",
      "matchPackageNames": ["cloudflare/cloudflared", "favonia/cloudflare-ddns"],
      "groupName": "cloudflare"
    },
    {
      "description": "Immich: server y machine-learning deben ir siempre en la misma versión",
      "matchPackageNames": ["ghcr.io/immich-app/**"],
      "groupName": "immich"
    },
    {
      "description": "Suite *arr y descargas (linuxserver): un PR semanal para revisar juntos",
      "matchPackageNames": ["lscr.io/linuxserver/**", "ghcr.io/flaresolverr/flaresolverr", "ghcr.io/seerr-team/seerr"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "media"
    },
    {
      "description": "qBittorrent de linuxserver tiene tags viejos con esquema de fecha (20.04.1) que parecen más nuevos",
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "allowedVersions": "<20"
    },
    {
      "description": "cert-manager y el plugin de CNPG van juntos",
      "matchPackageNames": ["cert-manager/cert-manager", "cloudnative-pg/plugin-barman-cloud"],
      "groupName": "cnpg-respaldos"
    },
    {
      "description": "Postgres: nunca saltos mayores automáticos (requieren pg_upgrade o importación)",
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql", "postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Imágenes fijadas por digest sin versiones publicadas: solo digest, mensual",
      "matchPackageNames": ["webodm/**", "opendronemap/nodeodm"],
      "schedule": ["* 6-12 1-7 * 6"]
    },
    {
      "description": "CUDA y device plugin dependen del driver del host: solo PR mensual",
      "matchPackageNames": ["nvidia/cuda", "nvcr.io/nvidia/**"],
      "schedule": ["* 6-12 1-7 * 6"]
    }
  ]
}
