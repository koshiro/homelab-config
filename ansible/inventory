[proxmox_host]
proxmox ansible_host=192.168.1.100

[truenas_vm]
truenas ansible_host=192.168.1.20

[k3s_master]
pibot ansible_host=pibot

[k3s_workers]
k3s-node-1 ansible_host=k3s-node-1-k3s
k3s-node-2 ansible_host=k3s-node-2-k3s
k3s-node-3 ansible_host=k3s-node-3-k3s

[k3s_nodes:children]
k3s_master
k3s_workers

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[proxmox_host:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_rsa

[truenas_vm:vars]
ansible_user=ansible
ansible_ssh_pass="{{ vault_truenas_password }}"
ansible_connection=ssh
ansible_ssh_pipelining=true

[k3s_nodes:vars]
ansible_user=daniel
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_become=yes
ansible_become_method=sudo
