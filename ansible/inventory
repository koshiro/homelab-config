# Inventario del Homelab - Arquitectura Actual
# Master: pibot (con etcd)
# Workers: k3s-node-1, k3s-node-2, k3s-node-3

[proxmox_host]
proxmox ansible_host=192.168.1.100

[truenas_vm]
truenas ansible_host=192.168.1.20

[k3s_master]
pibot ansible_host=pibot.local

[k3s_workers]
k3s-node-1 ansible_host=192.168.1.131
k3s-node-2 ansible_host=192.168.1.132
k3s-node-3 ansible_host=192.168.1.133

[k3s_nodes:children]
k3s_master
k3s_workers

# --- Variables ---

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[proxmox_host:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_rsa

[truenas_vm:vars]
ansible_user=ansible
ansible_password: "{{ vault_truenas_password }}"
ansible_connection=ssh
ansible_ssh_pipelining=true

[k3s_nodes:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_become=yes
ansible_become_method=sudo
