# ansible/vars/homelab_vars.yml.example
# COPIA ESTE FICHERO a ansible/vars/homelab_vars.yml y rellena tus valores.
# ESTE ES EL ÚNICO FICHERO QUE NECESITAS EDITAR.
# ---
# Conexión a Proxmox
proxmox_host: "192.168.1.10"
proxmox_user: "root@pam"
proxmox_api_token_id: "tu_token_id"
proxmox_api_token_secret: "tu_token_secret"

# Configuración de GPU Passthrough (obtener IDs con: lspci -n -s XX:XX)
gpu_vendor_device_id: "10de:2484,10de:228b"  # Ejemplo: NVIDIA RTX 3070 (VGA + Audio)

# Conexión a TrueNAS
truenas_host: "192.168.1.20"
truenas_initial_root_password: "tu_contraseña_root_inicial_truenas"
truenas_api_key: "GENERADO_AUTOMATICAMENTE"

# Configuración de Red
network_gateway: "192.168.1.1"
network_cidr: "192.168.1.0/24"

# Plantillas de VM en Proxmox (debes crearlas antes de ejecutar el playbook)
vm_templates:
  ubuntu: "ubuntu-cloud"      # Nombre de tu plantilla Ubuntu
  truenas: "truenas-template" # Nombre de tu plantilla TrueNAS

# Definición de las Máquinas Virtuales
vms:
  - name: truenas-core
    vmid: 100
    template: "{{ vm_templates.truenas }}"
    ip: "{{ truenas_host }}"
    cores: 2
    memory: 2048 # 2GB (ajustado para servidores con RAM limitada)
    # Passthrough de los discos de datos. Reemplaza con los IDs de tus discos.
    passthrough_disks:
      - "/dev/disk/by-id/scsi-SATA_Samsung_SSD_870_QVO_2TB_S5SSNF0R40..."
      - "/dev/disk/by-id/nvme-eui.002538b4..."

  - name: k3s-node-1
    vmid: 101
    template: "{{ vm_templates.ubuntu }}"
    ip: "192.168.1.31"
    cores: 4
    memory: 4096 # 4GB (ajustado para servidores con RAM limitada)
    # Passthrough de la GPU. Reemplaza con el ID de tu GPU.
    passthrough_gpu: "01:00.0"

  - name: k3s-node-2
    vmid: 102
    template: "{{ vm_templates.ubuntu }}"
    ip: "192.168.1.32"
    cores: 4
    memory: 4096 # 4GB (ajustado para servidores con RAM limitada)

  - name: k3s-node-3
    vmid: 103
    template: "{{ vm_templates.ubuntu }}"
    ip: "192.168.1.33"
    cores: 4
    memory: 4096 # 4GB (ajustado para servidores con RAM limitada)

# Configuración de TrueNAS
truenas_data_pool: "homelab-storage" # Nombre del pool de ZFS para datos (NO usar espacios ni dos puntos)
truenas_datasets:
  - { name: "media", description: "Librería principal de Plex" }
  - { name: "downloads", description: "Directorio de descargas" }
  - { name: "staging", description: "Área de trabajo para apps de medios" }
  - { name: "config-backups", description: "Backups de configuración de aplicaciones" }

# Configuración de GitOps
gitops_repo_url: "http://gitea.homelab.local/tu_usuario/homelab-config.git" # Cambia esto a la URL de tu repositorio homelab-config en tu instancia de Gitea autohospedada
gitops_repo_branch: "main"
