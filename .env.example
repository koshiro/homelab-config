# .env.example (v1.0)

# === Variables Globales ===
PUID=1000
PGID=1000
TZ=America/Santiago
DOMAIN_NAME=tu-dominio.com

# === Credenciales de Cloudflare ===
# Para Traefik (gestión de DNS para SSL) y el Túnel
CF_API_EMAIL=tu-email@cloudflare.com
CF_API_KEY=tu_api_key_de_cloudflare
CLOUDFLARE_TUNNEL_TOKEN=tu_token_del_tunel

# === IPs de las Máquinas Virtuales (asignadas en Proxmox) ===
IP_VM_DEV=192.168.1.10
IP_VM_GPU=192.168.1.11
IP_VM_MEDIA=192.168.1.12

# === Variables de Gitea ===
GITEA_DB_PASSWORD=generar_una_contraseña_segura